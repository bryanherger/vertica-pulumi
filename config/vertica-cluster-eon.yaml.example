# Vertica Eon Mode cluster configuration example
#
# Copy this file to config/config_eon.yaml (or another name) and customize it.
# Pulumi loads the file named in the Pulumi config key `vertica:config_file`
# or via the VERTICA_CONFIG_FILE environment variable.  The default is
# config/config.yaml.
#
# The working end-to-end flow is:
#   1. Customize this config.
#   2. pulumi stack init <stack>
#   3. pulumi config set vertica:config_file config/config_eon.yaml
#   4. pulumi up
#   5. python scripts/install_vertica_eon.py --config config/config_eon.yaml --ssh-key <private-key>
#
# Notes:
#   - connect_via_public_ip MUST be true when running Pulumi from outside the VPC.
#   - run_db_create_inline is false by default; database creation is delegated to
#     scripts/install_vertica_eon.py.
#   - s3_auth_mode: iam_role is recommended. Pulumi creates an IAM instance profile
#     and attaches it to every EC2 instance so Vertica can read/write communal storage.
#   - The Vertica RPM and license paths below are resolved relative to the project
#     directory if they are not absolute. RPM/license files are uploaded to every
#     node by install_vertica_eon.py.

compute:
  provider: aws
  aws:
    region: us-east-1
    key_name: vertica-automation      # AWS EC2 key pair *name* (private key path is passed to installer)
    instance_type: r6i.2xlarge        # Minimum for a 3-node test cluster
    root_volume_size: 100
    connect_via_public_ip: true       # Required when running from outside the VPC
    run_db_create_inline: false       # Keep false; install_vertica_eon.py creates the DB
    s3_auth_mode: iam_role            # iam_role | access_keys
    additional_volumes:
      - size: 500
        type: gp3
        mount_point: /data            # Depot, catalog, and data directories
    security_group_rules:
      - protocol: tcp
        port: 22
        cidr: 0.0.0.0/0
      - protocol: tcp
        port: 5433
        cidr: 0.0.0.0/0
      - protocol: tcp
        port: 5444
        cidr: 0.0.0.0/0
      - protocol: tcp
        port: 5554                    # Node Management Agent
        cidr: 0.0.0.0/0
      - protocol: tcp
        port: 8443                    # Vertica HTTPS service
        cidr: 0.0.0.0/0
      - protocol: tcp
        from_port: 5434
        to_port: 5444
        cidr: 0.0.0.0/0
      - protocol: tcp
        from_port: 4803
        to_port: 4803
        cidr: 10.0.0.0/16
      - protocol: tcp
        from_port: 6543
        to_port: 6543
        cidr: 10.0.0.0/16
    tags:
      Environment: dev
      Project: vertica-eon

vertica:
  version: "26.2.0-0"                 # Should match the RPM version below
  cluster_name: vertica-eon-cluster
  mode: eon

  license:
    local_path: "/path/to/vertica_license.xml"

  rpm:
    local_path: "/path/to/vertica-26.2.0-0.RHEL8.x86_64.rpm"

  database:
    name: pulumidb
    admin_username: dbadmin
    admin_password: "CHANGE_ME_USE_STRONG_PASSWORD"

  eon:
    communal_storage_location: "s3://my-vertica-bucket/pulumidb"
    shard_count: 3
    depot_path: /data/depot
    depot_size: "80%"
    aws_region: us-east-1              # Should match compute.aws.region
    aws_enable_https: true
    enable_s3_encryption: true

  nodes:
    count: 3
    data_path: /data/vertica
    catalog_path: /data/catalog

  security:
    generate_nma_certs: true           # Generates bootstrap TLS material locally and deploys to all nodes
    cert_validity_days: 365
    cert_country: "US"
    cert_state: "California"
    cert_locality: "San Francisco"
    cert_org: "MyOrganization"
    cert_ou: "DataPlatform"
    cert_cn: "vertica-nma"

bootstrap:
  prerequisites:
    - dialog
    - pcre
    - pcre2
    - sysstat
    - libxcrypt-compat
  packages:
    - vim
    - htop
    - tmux
    - wget
    - net-tools
    - psmisc
    - lsof
    - aws-cli
  pre_install:
    - "sysctl -w vm.max_map_count=262144"
    - "echo 'vm.max_map_count=262144' >> /etc/sysctl.conf"
    - "echo 'vm.swappiness=1' >> /etc/sysctl.conf"
    - "sysctl -p"
    - "fallocate -l 2G /swapfile && chmod 600 /swapfile && mkswap /swapfile && swapon /swapfile"
    - "echo '/swapfile none swap sw 0 0' >> /etc/fstab"
    - "echo 'dbadmin soft nofile 65536' >> /etc/security/limits.conf"
    - "echo 'dbadmin hard nofile 65536' >> /etc/security/limits.conf"
    - "mkdir -p /data/depot /data/vertica /data/catalog"
  post_install:
    - "echo 'Bootstrap complete' >> /var/log/vertica-bootstrap.log"
